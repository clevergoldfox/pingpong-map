// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  rating    Int      @default(500)
  seasonRating  Int      @default(500)  // current season rating
  tier         Tier @default(BRONZE)
  coins     Int      @default(0)
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())

  tournaments   TournamentParticipant[]
  matches1      Match[]                 @relation("MatchPlayer1")
  matches2      Match[]                 @relation("MatchPlayer2")
  ratingHistory RatingHistory[]
  @@index([rating])
}

enum Role {
  ADMIN
  ORGANIZER
  PLAYER
}

model Tournament {
  id        String           @id @default(uuid())
  name      String
  location  String
  status    TournamentStatus
  startDate DateTime
  createdAt DateTime         @default(now())

  categories   Category[]
  participants TournamentParticipant[]
  matches      Match[]
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECKIN
  STARTED
  FINISHED
  ARCHIVED
}

model Category {
  id           String            @id @default(uuid())
  tournamentId String
  type         CategoryType
  format       CompetitionFormat
  roundCount   Int               @default(3)
  currentRound Int               @default(0)

  isLocked Boolean @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]    @relation("CategoryMatches")
}

enum CategoryType {
  SINGLES
  DOUBLES
  TEAM
}

enum CompetitionFormat {
  ROUND_ROBIN
  SELECT_ROUND
  TOURNAMENT
  GROUP_TO_TOURNAMENT
}

enum ResultStatus {
  NONE // no submissions
  PENDING
  SUBMITTED
  IN_PROGRESS // submissions exist, not yet agreed
  LOCKED // match result locked (cannot edit)
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  categoryId   String
  player1Id    String
  player2Id    String?
  winnerId     String?
  status       MatchStatus

  // NEW:
  version      Int          @default(0)
  resultStatus ResultStatus @default(NONE)

  // Store canonical scores once agreed/locked
  // JSON structure example: [{game:1, p1:11, p2:8}, ...]
  scoreJson   Json?
  roundNumber Int?
  submissions MatchScoreSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  category      Category   @relation("CategoryMatches", fields: [categoryId], references: [id])
  ratingApplied Boolean    @default(false)

  player1       User            @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2       User?           @relation("MatchPlayer2", fields: [player2Id], references: [id])
  ratingHistory RatingHistory[]
  @@index([categoryId, roundNumber])
  @@index([tournamentId])
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  FORFEIT
}

enum JoinStatus {
  APPLIED
  PAID // 支払い完了（大会ページ閲覧可の前提）
  CANCELED // キャンセル
  FORFEITED // 棄権（チェックインしない等）
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  checkedIn    Boolean    @default(false)
  joinStatus   JoinStatus @default(APPLIED)
  joinedAt     DateTime   @default(now())
  canceledAt   DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model MatchScoreSubmission {
  id              String   @id @default(uuid())
  matchId         String
  submittedById   String
  clientRequestId String // idempotency key per device action
  scoreJson       Json
  createdAt       DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@unique([matchId, submittedById]) // 1 active submission per user (MVP)
  @@unique([matchId, clientRequestId]) // idempotency
}

model RatingHistory {
  id        String   @id @default(uuid())
  userId    String
  matchId   String
  seasonId  String
  oldRating Int
  newRating Int
  delta     Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  @@index([userId])
  @@index([matchId])
  @@index([seasonId])
  @@index([createdAt])
}

model Season {
  id        String   @id @default(uuid())
  name      String
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  ratingHistories RatingHistory[]
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
}

model TierHistory {
  id        String   @id @default(uuid())
  userId    String
  oldTier   Tier
  newTier   Tier
  createdAt DateTime @default(now())
}